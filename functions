activ8() {
    if [ ! -d "env" ]; then
        python3 -m venv env && source env/bin/activate
    else
        source env/bin/activate
    fi
}

date() {
    date | awk '{print $1, $3}'
}

scan() {
    nmap -T4 -sV -sC -vv $1 | tee scan 
}

stealthScan() {
    sudo nmap -T4 -sX | tee scan  
}

sweep() {
    nmap -T4 -sn $1
}

analyze() {
    file $1 
    checksec $1
}